{
	email {$ACME_EMAIL}
	admin off
}

{$API_DOMAIN} {
	encode zstd gzip

	# Never allow public traffic to internal monitoring and operational routes.
	@internal path /internal /internal/*
	respond @internal 404

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete *
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Hive-Proxy-Secret delete
				resp_headers>Set-Cookie delete
			}
		}
	}

	@photoUpload {
		method POST
		path /v1/me/photo
	}
	handle @photoUpload {
		# 5 MiB image plus multipart framing, limited again in Go.
		request_body {
			max_size 6MB
		}
		reverse_proxy api:8080 {
			health_uri /ready
			health_interval 15s
		}
	}

	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8080 {
			health_uri /ready
			health_interval 15s
		}
	}
}
