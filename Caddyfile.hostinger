{
    email {$ACME_EMAIL}
    admin off
}

# Only the website is public. /api/backend/* is same-origin Next.js,
# forwarded to api:8080 over Docker's private network.
import /etc/caddy/hive-site.caddy

{$SITE_DOMAIN} {
    # Non-production staging stays out of search results.
    @staging expression {env.HIVE_ENVIRONMENT} == "staging"
    header @staging X-Robots-Tag "noindex, nofollow"

    import hive_site web:3000
}

# Extra hostnames (e.g. www.<domain> in production) permanently redirect to the
# canonical site. Unset in staging: compose passes an http:// placeholder that
# never requests a certificate and matches no real traffic.
{$SITE_REDIRECT_FROM:http://redirect-unused.invalid} {
    header Strict-Transport-Security "max-age=31536000"
    redir https://{$SITE_DOMAIN}{uri} permanent
}
