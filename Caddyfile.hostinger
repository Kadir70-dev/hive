{
    email {$ACME_EMAIL}
    admin off
}

# Only the website is public. /api/backend/* is same-origin Next.js,
# forwarded to api:8080 over Docker's private network.
{$SITE_DOMAIN} {
    encode zstd gzip

    @internal path /internal /internal/*
    respond @internal 404

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete *
                }
                request>headers>Cookie delete
                request>headers>Authorization delete
                request>headers>X-Hive-Client-IP delete
                request>headers>X-Hive-Verified-Client-IP delete
                request>headers>X-Hive-Proxy-Secret delete
                resp_headers>Set-Cookie delete
            }
        }
    }

    reverse_proxy web:3000 {
        # Overwrite any client-supplied value. Next.js trusts this header ONLY
        # with HIVE_SITE_EDGE=caddy; the web container has no host port.
        header_up X-Hive-Verified-Client-IP {remote_host}
        header_up -X-Hive-Client-IP
        header_up -X-Hive-Proxy-Secret
        header_up -X-Nf-Client-Connection-Ip
    }
}
