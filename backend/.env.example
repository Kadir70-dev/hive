# Copy to backend/.env (untracked) and replace every value. Never commit the real file.
# Generate secrets with e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=change-this-long-random-secret
REDIS_PASSWORD=change-this-independent-random-secret
# Must equal HIVE_PROXY_SHARED_SECRET on Netlify (server-only env var), 32+ chars.
HIVE_PROXY_SHARED_SECRET=change-this-independent-random-secret-32-plus-chars
# 32 random bytes, base64: `openssl rand -base64 32`. Losing it means admins must re-enrol 2FA.
MFA_ENCRYPTION_KEY=
# resend (production) or log (development only: emails are not delivered).
MAIL_PROVIDER=resend
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. a dedicated subdomain (DNS change needs owner approval).
MAIL_FROM="The Hive Society <hello@mailer.thehivesociety.ae>"
# age PUBLIC key for encrypted backups (private key stays offline; see docs/operations/backup-and-restore.md).
BACKUP_AGE_RECIPIENT=
# Optional off-site backup copy via rclone, e.g. offsite:hive-backups (+ RCLONE_CONFIG_OFFSITE_* settings).
BACKUP_RCLONE_REMOTE=
# Public hostnames (staging uses its own values; see docs/operations/staging.md).
API_DOMAIN=api.thehivesociety.ae
ALLOWED_ORIGINS=https://thehivesociety.ae
PUBLIC_APP_URL=https://thehivesociety.ae

# Optional private Cloudflare R2 avatar bucket. No public bucket URL required.
# Create R2 S3 API credentials with permission only on this bucket.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# 0 means audit records are retained until a legal retention policy is approved.
# Setting a nonzero value requires at least 30 days.
AUDIT_RETENTION_DAYS=0
# Optional 32+ character bearer token for private /internal/metrics.
METRICS_TOKEN=
# Optional private, approved HTTPS webhook. Never include member data in alerts.
BACKUP_ALERT_WEBHOOK=
