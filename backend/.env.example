# Copy to backend/.env (untracked) and replace every value. Never commit the real file.
# Generate secrets with e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=change-this-long-random-secret
REDIS_PASSWORD=change-this-independent-random-secret
# Must equal HIVE_PROXY_SHARED_SECRET on Netlify (server-only env var), 32+ chars.
HIVE_PROXY_SHARED_SECRET=change-this-independent-random-secret-32-plus-chars
# 32 random bytes, base64: `openssl rand -base64 32`. Losing it means admins must re-enrol 2FA.
MFA_ENCRYPTION_KEY=
# resend (production) or log (development only: emails are not delivered).
MAIL_PROVIDER=resend
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. a dedicated subdomain (DNS change needs owner approval).
MAIL_FROM="The Hive Society <hello@mailer.thehivesociety.ae>"
