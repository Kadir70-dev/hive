# Copy to backend/.env (untracked) and replace every value with an independent
# long random secret, e.g. `openssl rand -hex 32`. Never commit the real file.
POSTGRES_PASSWORD=change-this-long-random-secret
REDIS_PASSWORD=change-this-independent-random-secret
# Must equal HIVE_PROXY_SHARED_SECRET on Netlify (server-only env var), 32+ chars.
HIVE_PROXY_SHARED_SECRET=change-this-independent-random-secret-32-plus-chars
