NEXT_PUBLIC_SITE_URL=https://thehivesociety.ae
# Server-side HTTPS endpoint for the Go API; do not expose an internal Docker hostname on Netlify.
HIVE_API_INTERNAL_URL=https://api.thehivesociety.ae
# Server-only. Must equal HIVE_PROXY_SHARED_SECRET on the API; lets the API trust the
# browser IP forwarded for rate limiting. Generate with `openssl rand -hex 32`.
HIVE_PROXY_SHARED_SECRET=
# The homepage AI chat/recommendation widgets are disabled (no backend).
